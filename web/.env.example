# Copy to .env.local for local development, and add the same names in
# Vercel under Project Settings > Environment Variables.
# Only login and online play need these. Bots, pass-and-play and
# Best move work without them.

# Supabase project URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, safe to expose in the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key, server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
